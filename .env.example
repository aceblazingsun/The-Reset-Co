# The Reset Co. — Serverless Environment Variables
# Configure these securely in your Vercel Project Settings (Settings -> Environment Variables)

# 1. Resend API Key for automated guest & doctor notifications
RESEND_API_KEY=re_your_production_resend_api_key

# 2. Email Sender & Doctor Inboxes
SENDER_EMAIL=The Reset Co <hello@thereset-co.in>
DOCTOR_EMAIL=hello@thereset-co.in,dr.aditya@thereset-co.in,dr.himanshu@thereset-co.in

# 3. Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Use service role key ONLY server-side for backend operations; never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 4. Operations HQ Dashboard Passkey (Server-Verified)
DASHBOARD_PASSKEY=your_secure_random_dashboard_passkey_here
DASHBOARD_SESSION_SECRET=your_32_byte_random_session_signing_secret_here

# 5. Supabase Webhook Secret (for verifying incoming database webhooks)
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret_here
